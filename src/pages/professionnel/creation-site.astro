---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import SectionTitle from "../../components/SectionTitle.astro";
---

<Layout title="BugZero — Création de site web & SEO, Fonds Bleu Monaco">
  <Header />

  <!-- Hero -->
  <section class="grid mx-auto max-w-[112rem] items-center gap-12 px-6 pb-20 pt-12 sm:px-10 lg:grid-cols-[1fr_0.9fr] lg:px-16 lg:py-24">
    <div class="max-w-3xl">
      <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">
        <span class="size-3 bg-[#c8d600]"></span>
        <span>Création de site</span>
      </div>
      <h1 class="text-5xl font-semibold leading-[0.98] tracking-tight text-[#263238] sm:text-6xl lg:text-7xl">
        Un site internet qui vous<br />
        <span class="text-[#00a7e1]">rapporte des clients.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-[#52636b]">
        Créé sur mesure. Jusqu'à 70% de subvention grâce au Fonds Bleu Monaco. 2 mois de maintenance offerts.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="mailto:bonjour@bugzero.fr" class="inline-flex h-15 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-lg font-medium text-white shadow-[0_14px_30px_rgba(0,167,225,0.2)] transition hover:bg-[#008fc7]">
          Je veux mon site
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
        <a href="tel:+33678565430" class="inline-flex h-15 items-center justify-center rounded-md border border-[#00a7e1] bg-white px-7 text-lg font-medium text-[#00a7e1] transition hover:bg-[#eaf8fd]">
          Nous appeler
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
      </div>
    </div>
    <div class="relative min-h-[25rem] overflow-hidden rounded-3xl border border-[#00a7e1]/20 bg-[#edfaff] sm:min-h-[31rem]">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_35%,rgba(200,214,0,0.34),transparent_23%),radial-gradient(circle_at_35%_70%,rgba(0,167,225,0.18),transparent_43%)]"></div>
      <div class="absolute left-[12%] right-[12%] top-1/2 h-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-[10%] h-[80%] w-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-1/2 grid size-52 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-[#00a7e1]/35 bg-white shadow-[0_25px_60px_rgba(0,167,225,0.18)] sm:size-64">
        <div class="grid size-[76%] place-items-center rounded-full border border-[#c8d600] bg-[#00a7e1]">
          <i data-lucide="globe" class="size-20 text-white sm:size-24"></i>
        </div>
      </div>
      <div class="absolute right-[9%] top-[12%] rounded-xl bg-white p-5 shadow-[0_16px_35px_rgba(0,0,0,0.1)]">
        <p class="text-sm font-medium text-[#52636b]">Subvention Fonds Bleu</p>
        <p class="mt-1 text-3xl font-semibold text-[#00a7e1]">70%</p>
      </div>
      <div class="absolute bottom-[12%] left-[8%] rounded-xl bg-[#263238] p-5 text-white shadow-xl">
        <p class="text-sm text-white/70">Maintenance offerte</p>
        <p class="mt-1 flex items-center text-lg font-semibold">
          <span class="mr-2 size-2 rounded-full bg-[#c8d600]"></span>
          2 mois
        </p>
      </div>
    </div>
  </section>

  <!-- Ce que nous créons -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Ce que nous créons pour vous" />
      <SectionTitle text="Un site pensé pour convertir vos visiteurs." />
      <div class="mt-12 grid gap-7 lg:grid-cols-4">
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-white p-8 shadow-sm sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#00a7e1] text-white">
            <i data-lucide="shopping-cart" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Tous types de sites</h3>
          <p class="mt-4 leading-relaxed text-[#52636b]">Vitrines, e-commerce, réservation en ligne.</p>
        </article>
        <article class="rounded-2xl border border-[#c8d600]/40 bg-[#f8fae9] p-8 shadow-sm sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#c8d600] text-[#263238]">
            <i data-lucide="smartphone" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Responsive</h3>
          <p class="mt-4 leading-relaxed text-[#52636b]">Design optimisé mobile, parfait sur tous écrans.</p>
        </article>
        <article class="rounded-2xl border border-[#263238]/10 bg-[#f4f5f5] p-8 shadow-sm sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#263238] text-white">
            <i data-lucide="search" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">SEO intégré</h3>
          <p class="mt-4 leading-relaxed text-[#52636b]">Mots-clés, contenu, balisage soignés.</p>
        </article>
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-[#edfaff] p-8 shadow-sm sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#00a7e1] text-white">
            <i data-lucide="share-2" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Contact &amp; réseaux</h3>
          <p class="mt-4 leading-relaxed text-[#52636b]">Formulaires, liens sociaux, blog inclus.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 3 étapes -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Votre projet en 3 étapes" />
      <SectionTitle text="Simple, rapide, sans mauvaise surprise." />
      <div class="mt-12 grid gap-7 lg:grid-cols-3">
        <article class="rounded-2xl bg-white p-8 shadow-sm sm:p-10">
          <p class="text-5xl font-semibold text-[#c8d600]">01</p>
          <span class="mt-8 grid size-12 place-items-center rounded-full bg-[#edfaff] text-[#00a7e1]">
            <i data-lucide="message-circle" class="size-6"></i>
          </span>
          <h3 class="mt-6 text-2xl font-semibold text-[#263238]">Brief découverte</h3>
          <p class="mt-3 text-lg leading-relaxed text-[#52636b]">
            Gratuit, 30 min. On cerne vos besoins et vos objectifs.
          </p>
        </article>
        <article class="rounded-2xl bg-white p-8 shadow-sm sm:p-10">
          <p class="text-5xl font-semibold text-[#00a7e1]">02</p>
          <span class="mt-8 grid size-12 place-items-center rounded-full bg-[#f8fae9] text-[#728000]">
            <i data-lucide="layout" class="size-6"></i>
          </span>
          <h3 class="mt-6 text-2xl font-semibold text-[#263238]">Maquette &amp; validation</h3>
          <p class="mt-3 text-lg leading-relaxed text-[#52636b]">
            Sous 7 jours, vous validez le design avant le développement.
          </p>
        </article>
        <article class="rounded-2xl bg-white p-8 shadow-sm sm:p-10">
          <p class="text-5xl font-semibold text-[#263238]">03</p>
          <span class="mt-8 grid size-12 place-items-center rounded-full bg-[#edfaff] text-[#00a7e1]">
            <i data-lucide="rocket" class="size-6"></i>
          </span>
          <h3 class="mt-6 text-2xl font-semibold text-[#263238]">Mise en ligne</h3>
          <p class="mt-3 text-lg leading-relaxed text-[#52636b]">
            Publication + formation à la mise à jour de votre site.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Fonds Bleu -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="relative overflow-hidden rounded-3xl border border-[#c8d600]/40 bg-[#f8fae9] px-8 py-14 sm:px-14">
        <div class="absolute -right-16 -top-16 size-56 rounded-full border-[1.5rem] border-[#c8d600]/20"></div>
        <div class="relative max-w-3xl">
          <SectionLabel text="Fonds Bleu Monaco" />
          <h2 class="mt-2 text-4xl font-semibold leading-tight tracking-tight text-[#263238] sm:text-5xl">
            L'État finance jusqu'à 70% de votre projet.
          </h2>
          <p class="mt-6 text-xl leading-relaxed text-[#52636b]">
            Vous êtes une entreprise monégasque ? L'État prend en charge 30 à 70% du coût. Nous montons le dossier avec vous.
          </p>
          <a href="mailto:bonjour@bugzero.fr" class="mt-8 inline-flex h-15 items-center justify-center rounded-md bg-[#c8d600] px-7 text-lg font-semibold text-[#263238] shadow-lg transition hover:bg-[#d9e800]">
            Démarrer mon projet
            <i data-lucide="arrow-right" class="ml-3 size-5"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Témoignage -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Témoignage" />
      <SectionTitle text="Un site qui fait grandir le business." />
      <div class="mt-12 grid gap-7 lg:grid-cols-3">
        <article class="flex min-h-[18rem] flex-col rounded-2xl bg-white p-8 shadow-sm lg:col-span-1">
          <div class="flex gap-1 text-[#c8d600]">
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
          </div>
          <blockquote class="mt-7 text-lg leading-relaxed text-[#52636b]">
            « Bugzero a créé notre boutique en ligne en 3 semaines. Nos ventes ont triplé. »
          </blockquote>
          <div class="mt-auto flex items-center gap-4 pt-8">
            <div class="grid size-12 place-items-center rounded-full bg-[#00a7e1] font-semibold text-white">C</div>
            <div>
              <p class="font-semibold text-[#263238]">Commerçant</p>
              <p class="text-sm text-[#52636b]">Monaco</p>
            </div>
          </div>
        </article>
        <article class="flex min-h-[18rem] flex-col justify-center rounded-2xl border border-[#00a7e1]/15 bg-[#edfaff] p-8 lg:col-span-2">
          <p class="text-lg leading-relaxed text-[#52636b]">
            Brief gratuit, maquette sous 7 jours, mise en ligne rapide. Et le Fonds Bleu pour tout financer.
          </p>
          <a href="mailto:bonjour@bugzero.fr" class="mt-6 inline-flex h-14 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-base font-medium text-white shadow-sm transition hover:bg-[#008fc7]">
            Démarrer mon projet
            <i data-lucide="mail" class="ml-2 size-5"></i>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA + Footer -->
  <section class="px-6 pt-20 sm:px-10 lg:px-16 lg:pt-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="relative overflow-hidden rounded-3xl bg-[#00a7e1] px-8 py-16 text-center text-white sm:px-14 lg:py-24">
        <div class="absolute -right-20 -top-20 size-72 rounded-full border-[2rem] border-white/10"></div>
        <div class="absolute -bottom-28 -left-16 size-64 rounded-full border-[2rem] border-[#c8d600]/50"></div>
        <div class="relative mx-auto max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#dff8ff]">Visibilité web</p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Démarrer mon projet.
          </h2>
          <p class="mt-4 text-lg text-white/80">
            06 78 56 54 30 | bonjour@bugzero.fr | 9, Allée Lazare Sauvaigo, 98000 Monaco
          </p>
          <a href="mailto:bonjour@bugzero.fr" class="mt-9 inline-flex h-15 items-center justify-center rounded-md bg-[#c8d600] px-8 text-lg font-semibold text-[#263238] shadow-lg transition hover:bg-[#d9e800]">
            Démarrer mon projet
            <i data-lucide="arrow-right" class="ml-3 size-5"></i>
          </a>
        </div>
      </div>
      <Footer />
    </div>
  </section>
</Layout>

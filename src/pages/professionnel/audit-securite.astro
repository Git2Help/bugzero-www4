---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import SectionTitle from "../../components/SectionTitle.astro";
---

<Layout title="BugZero — Audit de sécurité & test d'intrusion">
  <Header />

  <!-- Hero -->
  <section class="grid mx-auto max-w-[112rem] items-center gap-12 px-6 pb-20 pt-12 sm:px-10 lg:grid-cols-[1fr_0.9fr] lg:px-16 lg:py-24">
    <div class="max-w-3xl">
      <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">
        <span class="size-3 bg-[#c8d600]"></span>
        <span>Audit de sécurité</span>
      </div>
      <h1 class="text-5xl font-semibold leading-[0.98] tracking-tight text-[#263238] sm:text-6xl lg:text-7xl">
        Votre entreprise est-elle<br />
        <span class="text-[#00a7e1]">vraiment protégée ?</span>
      </h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-[#52636b]">
        Test d'intrusion complet à 500€ HT. Rapport détaillé en 48h.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="mailto:bonjour@bugzero.fr" class="inline-flex h-15 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-lg font-medium text-white shadow-[0_14px_30px_rgba(0,167,225,0.2)] transition hover:bg-[#008fc7]">
          Je demande un audit
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
        <a href="tel:+33678565430" class="inline-flex h-15 items-center justify-center rounded-md border border-[#00a7e1] bg-white px-7 text-lg font-medium text-[#00a7e1] transition hover:bg-[#eaf8fd]">
          Nous appeler
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
      </div>
    </div>
    <div class="relative min-h-[25rem] overflow-hidden rounded-3xl border border-[#00a7e1]/20 bg-[#edfaff] sm:min-h-[31rem]">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_35%,rgba(200,214,0,0.34),transparent_23%),radial-gradient(circle_at_35%_70%,rgba(0,167,225,0.18),transparent_43%)]"></div>
      <div class="absolute left-[12%] right-[12%] top-1/2 h-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-[10%] h-[80%] w-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-1/2 grid size-52 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-[#00a7e1]/35 bg-white shadow-[0_25px_60px_rgba(0,167,225,0.18)] sm:size-64">
        <div class="grid size-[76%] place-items-center rounded-full border border-[#c8d600] bg-[#00a7e1]">
          <i data-lucide="shield-alert" class="size-20 text-white sm:size-24"></i>
        </div>
      </div>
      <div class="absolute right-[9%] top-[12%] rounded-xl bg-white p-5 shadow-[0_16px_35px_rgba(0,0,0,0.1)]">
        <p class="text-sm font-medium text-[#52636b]">Rapport livré</p>
        <p class="mt-1 text-3xl font-semibold text-[#00a7e1]">48h</p>
      </div>
      <div class="absolute bottom-[12%] left-[8%] rounded-xl bg-[#263238] p-5 text-white shadow-xl">
        <p class="text-sm text-white/70">À partir de</p>
        <p class="mt-1 flex items-center text-lg font-semibold">
          <span class="mr-2 size-2 rounded-full bg-[#c8d600]"></span>
          500€ HT
        </p>
      </div>
    </div>
  </section>

  <!-- Pourquoi cet audit ? -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Pourquoi cet audit ?" />
      <SectionTitle text="Parce qu'une seule faille peut tout stopper." />
      <div class="mt-12 grid gap-7 lg:grid-cols-3">
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-[#edfaff] p-8 sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#00a7e1] text-white">
            <i data-lucide="alert-triangle" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">60% des PME</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            ayant subi une cyberattaque déposent le bilan sous 6 mois.
          </p>
        </article>
        <article class="rounded-2xl border border-[#c8d600]/40 bg-[#f8fae9] p-8 sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#c8d600] text-[#263238]">
            <i data-lucide="bug" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Vraies attaques simulées</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            Nos tests simulent phishing, ransomware et intrusion réseau.
          </p>
        </article>
        <article class="rounded-2xl border border-[#263238]/10 bg-[#f4f5f5] p-8 sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#263238] text-white">
            <i data-lucide="file-check" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Rapport actionnable</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            Failles détectées et correctifs à appliquer, en clair.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Ce que comprend l'audit -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Ce que comprend l'audit" />
      <SectionTitle text="Une sécurité complète, du parc à la conformité." />
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        <article class="rounded-xl border-l-4 border-[#00a7e1] bg-[#edfaff] p-7">
          <i data-lucide="network" class="size-7 text-[#00a7e1]"></i>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Analyse du parc informatique</h3>
          <p class="mt-2 leading-relaxed text-[#52636b]">Jusqu'à 30 IP/VLAN passés au crible.</p>
        </article>
        <article class="rounded-xl border-l-4 border-[#c8d600] bg-[#f8fae9] p-7">
          <i data-lucide="cpu" class="size-7 text-[#728000]"></i>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Test d'intrusion par IA</h3>
          <p class="mt-2 leading-relaxed text-[#52636b]">Automatisé avec notre partenaire SXIPHER.</p>
        </article>
        <article class="rounded-xl border-l-4 border-[#263238] bg-[#f4f5f5] p-7">
          <i data-lucide="list-checks" class="size-7 text-[#263238]"></i>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Rapport de vulnérabilités</h3>
          <p class="mt-2 leading-relaxed text-[#52636b]">Plan d'action priorisé, simple à suivre.</p>
        </article>
        <article class="rounded-xl border-l-4 border-[#00a7e1] bg-[#edfaff] p-7">
          <i data-lucide="shield-check" class="size-7 text-[#00a7e1]"></i>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Conformité RGPD &amp; NIS2</h3>
          <p class="mt-2 leading-relaxed text-[#52636b]">Incluse dans le rapport final.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Témoignage -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Témoignage" />
      <SectionTitle text="Ce que l'audit a changé pour eux." />
      <div class="mt-12 grid gap-7 lg:grid-cols-3">
        <article class="flex min-h-[18rem] flex-col rounded-2xl bg-white p-8 shadow-sm lg:col-span-1">
          <div class="flex gap-1 text-[#c8d600]">
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
          </div>
          <blockquote class="mt-7 text-lg leading-relaxed text-[#52636b]">
            « L'audit a révélé deux brèches critiques. Bugzero a corrigé le tout en une semaine. »
          </blockquote>
          <div class="mt-auto flex items-center gap-4 pt-8">
            <div class="grid size-12 place-items-center rounded-full bg-[#00a7e1] font-semibold text-white">P</div>
            <div>
              <p class="font-semibold text-[#263238]">PME</p>
              <p class="text-sm text-[#52636b]">Monaco</p>
            </div>
          </div>
        </article>
        <article class="flex min-h-[18rem] flex-col justify-center rounded-2xl border border-[#00a7e1]/15 bg-[#edfaff] p-8 lg:col-span-2">
          <p class="text-lg leading-relaxed text-[#52636b]">
            Un audit clair, un plan d'action concret. On détecte les failles avant les attaquants.
          </p>
          <a href="mailto:bonjour@bugzero.fr" class="mt-6 inline-flex h-14 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-base font-medium text-white shadow-sm transition hover:bg-[#008fc7]">
            Demander un audit
            <i data-lucide="mail" class="ml-2 size-5"></i>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA + Footer -->
  <section class="px-6 pt-20 sm:px-10 lg:px-16 lg:pt-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="relative overflow-hidden rounded-3xl bg-[#00a7e1] px-8 py-16 text-center text-white sm:px-14 lg:py-24">
        <div class="absolute -right-20 -top-20 size-72 rounded-full border-[2rem] border-white/10"></div>
        <div class="absolute -bottom-28 -left-16 size-64 rounded-full border-[2rem] border-[#c8d600]/50"></div>
        <div class="relative mx-auto max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#dff8ff]">Sécurité</p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Protégez votre activité dès maintenant.
          </h2>
          <a href="mailto:bonjour@bugzero.fr" class="mt-9 inline-flex h-15 items-center justify-center rounded-md bg-[#c8d600] px-8 text-lg font-semibold text-[#263238] shadow-lg transition hover:bg-[#d9e800]">
            Demander un audit
            <i data-lucide="arrow-right" class="ml-3 size-5"></i>
          </a>
        </div>
      </div>
      <Footer />
    </div>
  </section>
</Layout>

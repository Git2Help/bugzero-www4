---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import SectionTitle from "../../components/SectionTitle.astro";
---

<Layout title="BugZero — Maintenance Pro, service IT dédié dès 79€ HT/mois">
  <Header />

  <!-- Hero -->
  <section class="grid mx-auto max-w-[112rem] items-center gap-12 px-6 pb-20 pt-12 sm:px-10 lg:grid-cols-[1fr_0.9fr] lg:px-16 lg:py-24">
    <div class="max-w-3xl">
      <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">
        <span class="size-3 bg-[#c8d600]"></span>
        <span>Maintenance Pro</span>
      </div>
      <h1 class="text-5xl font-semibold leading-[0.98] tracking-tight text-[#263238] sm:text-6xl lg:text-7xl">
        Votre service IT dédié,<br />
        <span class="text-[#00a7e1]">sans le salaire. Dès 79€ HT/mois.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-[#52636b]">
        Surveillance 24/7, antivirus, sauvegardes et support inclus.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="#formules" class="inline-flex h-15 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-lg font-medium text-white shadow-[0_14px_30px_rgba(0,167,225,0.2)] transition hover:bg-[#008fc7]">
          Comparer les formules
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
        <a href="mailto:bonjour@bugzero.fr" class="inline-flex h-15 items-center justify-center rounded-md border border-[#00a7e1] bg-white px-7 text-lg font-medium text-[#00a7e1] transition hover:bg-[#eaf8fd]">
          Demander un devis
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
      </div>
    </div>
    <div class="relative min-h-[25rem] overflow-hidden rounded-3xl border border-[#00a7e1]/20 bg-[#edfaff] sm:min-h-[31rem]">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_35%,rgba(200,214,0,0.34),transparent_23%),radial-gradient(circle_at_35%_70%,rgba(0,167,225,0.18),transparent_43%)]"></div>
      <div class="absolute left-[12%] right-[12%] top-1/2 h-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-[10%] h-[80%] w-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-1/2 grid size-52 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-[#00a7e1]/35 bg-white shadow-[0_25px_60px_rgba(0,167,225,0.18)] sm:size-64">
        <div class="grid size-[76%] place-items-center rounded-full border border-[#c8d600] bg-[#00a7e1]">
          <i data-lucide="activity" class="size-20 text-white sm:size-24"></i>
        </div>
      </div>
      <div class="absolute right-[9%] top-[12%] rounded-xl bg-white p-5 shadow-[0_16px_35px_rgba(0,0,0,0.1)]">
        <p class="text-sm font-medium text-[#52636b]">Dès</p>
        <p class="mt-1 text-3xl font-semibold text-[#00a7e1]">79€/mois</p>
      </div>
      <div class="absolute bottom-[12%] left-[8%] rounded-xl bg-[#263238] p-5 text-white shadow-xl">
        <p class="text-sm text-white/70">Supervision</p>
        <p class="mt-1 flex items-center text-lg font-semibold">
          <span class="mr-2 size-2 rounded-full bg-[#c8d600]"></span>
          24/7
        </p>
      </div>
    </div>
  </section>

  <!-- Tableau comparatif -->
  <section id="formules" class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Nos formules" />
      <SectionTitle text="4 niveaux d'accompagnement, sans engagement." />
      <div class="mt-12 grid gap-7 lg:grid-cols-4">
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-white p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">Supervision-Assistance</p>
          <p class="mt-4 text-4xl font-semibold text-[#263238]">79€<span class="text-lg font-normal text-[#52636b]">/mois HT</span></p>
          <p class="mt-5 leading-relaxed text-[#52636b]">
            L'essentiel pour démarrer. Supervision automatique, antivirus Bitdefender, sauvegarde MSP360.
          </p>
        </article>
        <article class="rounded-2xl border border-[#c8d600]/40 bg-[#f8fae9] p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#728000]">Liberté</p>
          <p class="mt-4 text-4xl font-semibold text-[#263238]">99€<span class="text-lg font-normal text-[#52636b]">/mois HT</span></p>
          <p class="mt-5 leading-relaxed text-[#52636b]">
            Un pas vers la tranquillité. +1 appel par mois, 6 tickets, assistance à distance.
          </p>
        </article>
        <article class="rounded-2xl border border-[#263238]/10 bg-[#f4f5f5] p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#263238]">Puissance</p>
          <p class="mt-4 text-4xl font-semibold text-[#263238]">149€<span class="text-lg font-normal text-[#52636b]">/mois HT</span></p>
          <p class="mt-5 leading-relaxed text-[#52636b]">
            Pour les équipes actives. +3 appels, 3h sur site à Monaco et PACA.
          </p>
        </article>
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-[#edfaff] p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">Illimitée</p>
          <p class="mt-4 text-4xl font-semibold text-[#263238]">249€<span class="text-lg font-normal text-[#52636b]">/mois HT</span></p>
          <p class="mt-5 leading-relaxed text-[#52636b]">
            La totale sérénité. Appels illimités, 1 journée de présence sur site par mois.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Pourquoi choisir Bugzero -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <SectionLabel text="Pourquoi choisir Bugzero" />
          <h2 class="text-4xl font-semibold leading-tight tracking-tight text-[#263238] sm:text-5xl">
            On surveille, on sécurise, on sauvegarde.
          </h2>
          <p class="mt-6 text-xl leading-relaxed text-[#52636b]">
            Vous gardez le contrôle de votre business. On garde le contrôle de votre IT.
          </p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <article class="rounded-xl border-l-4 border-[#00a7e1] bg-[#edfaff] p-7">
            <i data-lucide="zap" class="size-7 text-[#00a7e1]"></i>
            <h3 class="mt-5 text-xl font-semibold text-[#263238]">Réponse &lt; 2h</h3>
            <p class="mt-2 leading-relaxed text-[#52636b]">En heures ouvrées, on revient vers vous vite.</p>
          </article>
          <article class="rounded-xl border-l-4 border-[#c8d600] bg-[#f8fae9] p-7">
            <i data-lucide="shield" class="size-7 text-[#728000]"></i>
            <h3 class="mt-5 text-xl font-semibold text-[#263238]">Antivirus nouvelle génération</h3>
            <p class="mt-2 leading-relaxed text-[#52636b]">Anti-ransomware, protection en temps réel.</p>
          </article>
          <article class="rounded-xl border-l-4 border-[#263238] bg-[#f4f5f5] p-7 sm:col-span-2">
            <i data-lucide="cloud" class="size-7 text-[#263238]"></i>
            <h3 class="mt-5 text-xl font-semibold text-[#263238]">Sauvegardes cloud automatiques</h3>
            <p class="mt-2 leading-relaxed text-[#52636b]">Restaurables en un clic, vos données sont toujours à l'abri.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Témoignage -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Témoignage" />
      <SectionTitle text="La tranquillité d'un service IT, sans le coût." />
      <div class="mt-12 grid gap-7 lg:grid-cols-3">
        <article class="flex min-h-[18rem] flex-col rounded-2xl bg-white p-8 shadow-sm lg:col-span-1">
          <div class="flex gap-1 text-[#c8d600]">
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
            <i data-lucide="star" class="size-5 fill-current"></i>
          </div>
          <blockquote class="mt-7 text-lg leading-relaxed text-[#52636b]">
            « Depuis que Bugzero gère notre maintenance, on n'a plus jamais perdu un fichier. »
          </blockquote>
          <div class="mt-auto flex items-center gap-4 pt-8">
            <div class="grid size-12 place-items-center rounded-full bg-[#00a7e1] font-semibold text-white">C</div>
            <div>
              <p class="font-semibold text-[#263238]">Cabinet comptable</p>
              <p class="text-sm text-[#52636b]">Nice</p>
            </div>
          </div>
        </article>
        <article class="flex min-h-[18rem] flex-col justify-center rounded-2xl border border-[#00a7e1]/15 bg-[#edfaff] p-8 lg:col-span-2">
          <p class="text-lg leading-relaxed text-[#52636b]">
            Choisissez la formule adaptée à votre activité. Évolutive à tout moment, sans engagement.
          </p>
          <a href="mailto:bonjour@bugzero.fr" class="mt-6 inline-flex h-14 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-base font-medium text-white shadow-sm transition hover:bg-[#008fc7]">
            Je choisis ma formule
            <i data-lucide="mail" class="ml-2 size-5"></i>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA + Footer -->
  <section class="px-6 pt-20 sm:px-10 lg:px-16 lg:pt-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="relative overflow-hidden rounded-3xl bg-[#00a7e1] px-8 py-16 text-center text-white sm:px-14 lg:py-24">
        <div class="absolute -right-20 -top-20 size-72 rounded-full border-[2rem] border-white/10"></div>
        <div class="absolute -bottom-28 -left-16 size-64 rounded-full border-[2rem] border-[#c8d600]/50"></div>
        <div class="relative mx-auto max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#dff8ff]">Prêt à démarrer ?</p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Je choisis ma formule.
          </h2>
          <p class="mt-4 text-lg text-white/80">
            06 78 56 54 30 | bonjour@bugzero.fr | 9, Allée Lazare Sauvaigo, 98000 Monaco
          </p>
          <a href="mailto:bonjour@bugzero.fr" class="mt-9 inline-flex h-15 items-center justify-center rounded-md bg-[#c8d600] px-8 text-lg font-semibold text-[#263238] shadow-lg transition hover:bg-[#d9e800]">
            Je choisis ma formule
            <i data-lucide="arrow-right" class="ml-3 size-5"></i>
          </a>
        </div>
      </div>
      <Footer />
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionLabel from "../components/SectionLabel.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<Layout title="BugZero — Qui sommes-nous ? L'équipe monégasque">
  <Header />

  <!-- Hero -->
  <section class="grid mx-auto max-w-[112rem] items-center gap-12 px-6 pb-20 pt-12 sm:px-10 lg:grid-cols-[1fr_0.9fr] lg:px-16 lg:py-24">
    <div class="max-w-3xl">
      <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">
        <span class="size-3 bg-[#c8d600]"></span>
        <span>Qui sommes-nous ?</span>
      </div>
      <h1 class="text-5xl font-semibold leading-[0.98] tracking-tight text-[#263238] sm:text-6xl lg:text-7xl">
        Qui se cache derrière<br />
        <span class="text-[#00a7e1]">Bugzero ?</span>
      </h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-[#52636b]">
        Une équipe monégasque de passionnés, à votre service depuis 15 ans.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="tel:+33678565430" class="inline-flex h-15 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-lg font-medium text-white shadow-[0_14px_30px_rgba(0,167,225,0.2)] transition hover:bg-[#008fc7]">
          Nous appeler
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
        <a href="mailto:bonjour@bugzero.fr" class="inline-flex h-15 items-center justify-center rounded-md border border-[#00a7e1] bg-white px-7 text-lg font-medium text-[#00a7e1] transition hover:bg-[#eaf8fd]">
          Nous écrire
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
      </div>
    </div>
    <div class="relative min-h-[25rem] overflow-hidden rounded-3xl border border-[#00a7e1]/20 bg-[#edfaff] sm:min-h-[31rem]">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_35%,rgba(200,214,0,0.34),transparent_23%),radial-gradient(circle_at_35%_70%,rgba(0,167,225,0.18),transparent_43%)]"></div>
      <div class="absolute left-[12%] right-[12%] top-1/2 h-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-[10%] h-[80%] w-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-1/2 grid size-52 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-[#00a7e1]/35 bg-white shadow-[0_25px_60px_rgba(0,167,225,0.18)] sm:size-64">
        <div class="grid size-[76%] place-items-center rounded-full border border-[#c8d600] bg-[#00a7e1]">
          <i data-lucide="users" class="size-20 text-white sm:size-24"></i>
        </div>
      </div>
      <div class="absolute right-[9%] top-[12%] rounded-xl bg-white p-5 shadow-[0_16px_35px_rgba(0,0,0,0.1)]">
        <p class="text-sm font-medium text-[#52636b]">Ans d'expertise</p>
        <p class="mt-1 text-3xl font-semibold text-[#00a7e1]">15</p>
      </div>
      <div class="absolute bottom-[12%] left-[8%] rounded-xl bg-[#263238] p-5 text-white shadow-xl">
        <p class="text-sm text-white/70">Clients</p>
        <p class="mt-1 flex items-center text-lg font-semibold">
          <span class="mr-2 size-2 rounded-full bg-[#c8d600]"></span>
          800+
        </p>
      </div>
    </div>
  </section>

  <!-- Corps -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <SectionLabel text="Notre histoire" />
          <h2 class="text-4xl font-semibold leading-tight tracking-tight text-[#263238] sm:text-5xl">
            Rendre l'informatique simple, fiable et sécurisée.
          </h2>
        </div>
        <div class="space-y-6 text-lg leading-relaxed text-[#52636b]">
          <p>
            Bugzero est la marque grand public et professionnelle de <a href="https://www.helperiance.com" class="font-semibold text-[#00a7e1] hover:underline">Helperiance</a>, société fondée en 2010 par Johan Chauvet (CEO) et Lyonel Sireuille (associé).
          </p>
          <p>
            Notre mission : rendre l'informatique simple, fiable et sécurisée pour les particuliers comme pour les entreprises.
          </p>
          <p>
            Basés au 9, Allée Lazare Sauvaigo à Monaco, nous intervenons dans tout le bassin monégasque, de Nice à Menton.
          </p>
          <p>
            Bugzero s'appuie sur une équipe de techniciens certifiés (Frédéric, Alex, Camelia) et des partenaires de confiance : Monaco Cloud, Dell, Bitdefender.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Équipe -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Notre équipe" />
      <SectionTitle text="Des experts à votre service." />
      <div class="mt-12 grid gap-7 lg:grid-cols-4">
        <article class="rounded-2xl bg-white p-8 shadow-sm text-center">
          <div class="grid size-20 mx-auto place-items-center rounded-full bg-[#00a7e1] font-semibold text-white text-2xl">JC</div>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Johan Chauvet</h3>
          <p class="text-sm text-[#52636b]">CEO &amp; fondateur</p>
        </article>
        <article class="rounded-2xl bg-white p-8 shadow-sm text-center">
          <div class="grid size-20 mx-auto place-items-center rounded-full bg-[#c8d600] font-semibold text-[#263238] text-2xl">LS</div>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Lyonel Sireuille</h3>
          <p class="text-sm text-[#52636b]">Associé</p>
        </article>
        <article class="rounded-2xl bg-white p-8 shadow-sm text-center">
          <div class="grid size-20 mx-auto place-items-center rounded-full bg-[#263238] font-semibold text-white text-2xl">F</div>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Frédéric</h3>
          <p class="text-sm text-[#52636b]">Technicien support</p>
        </article>
        <article class="rounded-2xl bg-white p-8 shadow-sm text-center">
          <div class="grid size-20 mx-auto place-items-center rounded-full bg-[#00a7e1] font-semibold text-white text-2xl">A</div>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Alex &amp; Camelia</h3>
          <p class="text-sm text-[#52636b]">Développeurs</p>
        </article>
      </div>
      <p class="mt-8 text-center text-lg text-[#52636b]">
        Et nos partenaires : Monaco Cloud, Dell, Bitdefender, The Idea Starter.
      </p>
    </div>
  </section>

  <!-- Contact + Footer -->
  <section class="px-6 pt-20 sm:px-10 lg:px-16 lg:pt-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="relative overflow-hidden rounded-3xl bg-[#00a7e1] px-8 py-16 text-center text-white sm:px-14 lg:py-24">
        <div class="absolute -right-20 -top-20 size-72 rounded-full border-[2rem] border-white/10"></div>
        <div class="absolute -bottom-28 -left-16 size-64 rounded-full border-[2rem] border-[#c8d600]/50"></div>
        <div class="relative mx-auto max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#dff8ff]">Contact</p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Parlons de votre projet.
          </h2>
          <p class="mt-4 text-lg text-white/80">
            06 78 56 54 30 | bonjour@bugzero.fr | 9, Allée Lazare Sauvaigo, 98000 Monaco
          </p>
          <a href="tel:+33678565430" class="mt-9 inline-flex h-15 items-center justify-center rounded-md bg-[#c8d600] px-8 text-lg font-semibold text-[#263238] shadow-lg transition hover:bg-[#d9e800]">
            Appeler l'équipe
            <i data-lucide="arrow-right" class="ml-3 size-5"></i>
          </a>
        </div>
      </div>
      <Footer />
    </div>
  </section>
</Layout>

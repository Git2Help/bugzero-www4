---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionLabel from "../components/SectionLabel.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<Layout title="BugZero — Votre partenaire IT à Monaco">
  <Header />

  <!-- Section 1 : Hero -->
  <section class="grid mx-auto max-w-[112rem] items-center gap-12 px-6 pb-20 pt-12 sm:px-10 lg:grid-cols-[1fr_0.9fr] lg:px-16 lg:py-24">
    <div class="max-w-3xl">
      <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">
        <span class="size-3 bg-[#c8d600]"></span>
        <span>Infogérance professionnelle</span>
      </div>
      <h1 class="text-5xl font-semibold leading-[0.98] tracking-tight text-[#263238] sm:text-6xl lg:text-7xl">
        Votre partenaire IT<br />
        <span class="text-[#00a7e1]">à Monaco.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-[#52636b]">
        BugZero accompagne les entreprises monégasques et de la Côte d'Azur
        avec des solutions d'infogérance sur-mesure. Sécurité, performance,
        sérénité.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="/contact" class="inline-flex h-15 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-lg font-medium text-white shadow-[0_14px_30px_rgba(0,167,225,0.2)] transition hover:bg-[#008fc7]">
          Nous contacter
          <i data-lucide="arrow-right" class="ml-3 size-5"></i>
        </a>
      </div>
    </div>
    <div class="relative min-h-[25rem] overflow-hidden rounded-3xl border border-[#00a7e1]/20 bg-[#edfaff] sm:min-h-[31rem]">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_35%,rgba(200,214,0,0.34),transparent_23%),radial-gradient(circle_at_35%_70%,rgba(0,167,225,0.18),transparent_43%)]"></div>
      <div class="absolute left-[12%] right-[12%] top-1/2 h-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-[10%] h-[80%] w-px bg-[#00a7e1]/25"></div>
      <div class="absolute left-1/2 top-1/2 grid size-52 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-[#00a7e1]/35 bg-white shadow-[0_25px_60px_rgba(0,167,225,0.18)] sm:size-64">
        <div class="grid size-[76%] place-items-center rounded-full border border-[#c8d600] bg-[#00a7e1]">
          <i data-lucide="building-2" class="size-20 text-white sm:size-24"></i>
        </div>
      </div>
      <div class="absolute right-[9%] top-[12%] rounded-xl bg-white p-5 shadow-[0_16px_35px_rgba(0,0,0,0.1)]">
        <p class="text-sm font-medium text-[#52636b]">Entreprises accompagnées</p>
        <p class="mt-1 text-3xl font-semibold text-[#00a7e1]">50+</p>
      </div>
      <div class="absolute bottom-[12%] left-[8%] rounded-xl bg-[#263238] p-5 text-white shadow-xl">
        <p class="text-sm text-white/70">Disponibilité</p>
        <p class="mt-1 flex items-center text-lg font-semibold">
          <span class="mr-2 size-2 rounded-full bg-[#c8d600]"></span>
          24/7
        </p>
      </div>
    </div>
  </section>

  <!-- Section 2 : 4 formules maintenance -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Nos formules" />
      <SectionTitle text="4 formules de maintenance adaptées à votre entreprise." />
      <p class="mt-4 text-lg leading-relaxed text-[#52636b] max-w-3xl">
        De la PME à la grande entreprise, choisissez le niveau d'accompagnement
        dont vous avez besoin.
      </p>
      <div class="mt-12 grid gap-7 lg:grid-cols-4">
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-white p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">Starter</p>
          <p class="mt-4 text-4xl font-semibold text-[#263238]">199€<span class="text-lg font-normal text-[#52636b]">/mois</span></p>
          <ul class="mt-6 space-y-3 text-[#52636b]">
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> Support 5j/7</li>
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> Maintenance préventive</li>
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> 1 poste serveur</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-[#c8d600]/40 bg-[#f8fae9] p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#728000]">Pro</p>
          <p class="mt-4 text-4xl font-semibold text-[#263238]">399€<span class="text-lg font-normal text-[#52636b]">/mois</span></p>
          <ul class="mt-6 space-y-3 text-[#52636b]">
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> Support 6j/7</li>
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> Sauvegarde cloud incluse</li>
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> 3 postes serveurs</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-[#263238]/10 bg-[#f4f5f5] p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#263238]">Business</p>
          <p class="mt-4 text-4xl font-semibold text-[#263238]">699€<span class="text-lg font-normal text-[#52636b]">/mois</span></p>
          <ul class="mt-6 space-y-3 text-[#52636b]">
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> Support 7j/7</li>
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> Cybersécurité incluse</li>
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> 5 postes serveurs</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-[#edfaff] p-8 shadow-sm sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#00a7e1]">Enterprise</p>
          <p class="mt-4 text-4xl font-semibold text-[#263238]">1299€<span class="text-lg font-normal text-[#52636b]">/mois</span></p>
          <ul class="mt-6 space-y-3 text-[#52636b]">
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> Support 24/7</li>
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> Infrastructure complète</li>
            <li class="flex items-center gap-2"><i data-lucide="check" class="size-4 text-[#c8d600]"></i> 10+ postes serveurs</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 3 : SécuriSite WP Pro -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="SécuriSite WP Pro" />
      <SectionTitle text="Protégez votre site WordPress." />
      <p class="mt-4 text-lg leading-relaxed text-[#52636b] max-w-3xl">
        Sécurisation complète de votre site WordPress : firewall, mises à jour
        automatiques, scans de vulnérabilités et sauvegardes quotidiennes.
      </p>
      <div class="mt-10 flex items-end gap-6">
        <p class="text-5xl font-semibold text-[#263238]">99€<span class="text-xl font-normal text-[#52636b]">/mois</span></p>
        <a href="/contact" class="inline-flex h-14 items-center justify-center rounded-md bg-[#00a7e1] px-7 text-base font-medium text-white shadow-sm transition hover:bg-[#008fc7]">
          Je veux sécuriser mon site
          <i data-lucide="arrow-right" class="ml-2 size-5"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 4 : Cybersécurité -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Cybersécurité" />
      <SectionTitle text="Anticipez les menaces, respectez les normes." />
      <div class="mt-12 grid gap-7 lg:grid-cols-3">
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-[#edfaff] p-8 sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#00a7e1] text-white">
            <i data-lucide="search" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Test d'intrusion</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            Identifiez les failles de votre infrastructure avant les pirates.
            Rapport détaillé et préconisations.
          </p>
        </article>
        <article class="rounded-2xl border border-[#c8d600]/40 bg-[#f8fae9] p-8 sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#c8d600] text-[#263238]">
            <i data-lucide="shield" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Bitdefender Business</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            Protection antivirus nouvelle génération pour l'ensemble de votre
            parc informatique.
          </p>
        </article>
        <article class="rounded-2xl border border-[#263238]/10 bg-[#f4f5f5] p-8 sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#263238] text-white">
            <i data-lucide="file-text" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Conformité RGPD &amp; NIS2</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            Mettez votre entreprise en conformité avec les réglementations
            européennes et monégasques.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 5 : Visibilité web -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Visibilité web" />
      <SectionTitle text="Faites connaître votre entreprise." />
      <p class="mt-4 text-lg leading-relaxed text-[#52636b] max-w-3xl">
        De la création de site vitrine au référencement naturel, nous vous
        aidons à gagner en visibilité sur le web.
      </p>
      <div class="mt-12 grid gap-7 lg:grid-cols-3">
        <article class="rounded-2xl border border-[#00a7e1]/15 bg-white p-8 shadow-sm sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#00a7e1] text-white">
            <i data-lucide="globe" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Création de site</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            Site vitrine, e-commerce ou sur-mesure. Design moderne et adapté à
            votre image.
          </p>
        </article>
        <article class="rounded-2xl border border-[#c8d600]/40 bg-white p-8 shadow-sm sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#c8d600] text-[#263238]">
            <i data-lucide="trending-up" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">SEO &amp; SEA</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            Optimisez votre référencement naturel et lancez des campagnes
            publicitaires ciblées.
          </p>
        </article>
        <article class="rounded-2xl border border-[#263238]/10 bg-[#f4f5f5] p-8 sm:p-10">
          <span class="grid size-14 place-items-center rounded-xl bg-[#263238] text-white">
            <i data-lucide="banknote" class="size-7"></i>
          </span>
          <h3 class="mt-7 text-2xl font-semibold text-[#263238]">Fonds Bleu 30-70%</h3>
          <p class="mt-4 text-lg leading-relaxed text-[#52636b]">
            Profitez des aides du Fonds Bleu pour financer votre transition
            numérique à Monaco.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 6 : Pack Infogérance -->
  <section class="bg-[#f4f5f5] px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <SectionLabel text="Pack Infogérance" />
          <h2 class="text-4xl font-semibold leading-tight tracking-tight text-[#263238] sm:text-5xl">
            Installation, assistance et backup cloud.
          </h2>
          <p class="mt-6 text-xl leading-relaxed text-[#52636b]">
            Un pack complet pour installer votre infrastructure, former vos
            équipes et sécuriser vos données avec HelpBackup cloud.
          </p>
          <a href="/contact" class="mt-8 inline-flex items-center font-semibold text-[#00a7e1]">
            En savoir plus
            <i data-lucide="arrow-right" class="ml-2 size-5"></i>
          </a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <article class="rounded-xl border-l-4 border-[#00a7e1] bg-[#edfaff] p-7">
            <i data-lucide="settings" class="size-7 text-[#00a7e1]"></i>
            <h3 class="mt-5 text-xl font-semibold text-[#263238]">Installation</h3>
            <p class="mt-2 leading-relaxed text-[#52636b]">
              Déploiement et configuration de vos serveurs et postes de travail.
            </p>
          </article>
          <article class="rounded-xl border-l-4 border-[#c8d600] bg-[#f8fae9] p-7">
            <i data-lucide="headphones" class="size-7 text-[#728000]"></i>
            <h3 class="mt-5 text-xl font-semibold text-[#263238]">Assistance</h3>
            <p class="mt-2 leading-relaxed text-[#52636b]">
              Support technique réactif pour vos équipes au quotidien.
            </p>
          </article>
          <article class="rounded-xl border-l-4 border-[#00a7e1] bg-[#edfaff] p-7">
            <i data-lucide="cloud" class="size-7 text-[#00a7e1]"></i>
            <h3 class="mt-5 text-xl font-semibold text-[#263238]">HelpBackup Cloud</h3>
            <p class="mt-2 leading-relaxed text-[#52636b]">
              Sauvegarde externalisée et restauration rapide de vos données.
            </p>
          </article>
          <article class="rounded-xl border-l-4 border-[#263238] bg-[#f4f5f5] p-7">
            <i data-lucide="graduation-cap" class="size-7 text-[#263238]"></i>
            <h3 class="mt-5 text-xl font-semibold text-[#263238]">Formation</h3>
            <p class="mt-2 leading-relaxed text-[#52636b]">
              Formez vos collaborateurs aux outils et bonnes pratiques.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7 : À propos / Équipe -->
  <section class="px-6 py-20 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-[112rem]">
      <SectionLabel text="Notre équipe" />
      <SectionTitle text="Des experts à votre service." />
      <div class="mt-12 grid gap-7 lg:grid-cols-4">
        <article class="rounded-2xl bg-white p-8 shadow-sm text-center">
          <div class="grid size-20 mx-auto place-items-center rounded-full bg-[#00a7e1] font-semibold text-white text-2xl">J</div>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Johan</h3>
          <p class="text-sm text-[#52636b]">Fondateur &amp; Expert IT</p>
        </article>
        <article class="rounded-2xl bg-white p-8 shadow-sm text-center">
          <div class="grid size-20 mx-auto place-items-center rounded-full bg-[#c8d600] font-semibold text-[#263238] text-2xl">P</div>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Paul</h3>
          <p class="text-sm text-[#52636b]">Ingénieur systèmes</p>
        </article>
        <article class="rounded-2xl bg-white p-8 shadow-sm text-center">
          <div class="grid size-20 mx-auto place-items-center rounded-full bg-[#263238] font-semibold text-white text-2xl">A</div>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Alex</h3>
          <p class="text-sm text-[#52636b]">Cybersécurité</p>
        </article>
        <article class="rounded-2xl bg-white p-8 shadow-sm text-center">
          <div class="grid size-20 mx-auto place-items-center rounded-full bg-[#00a7e1] font-semibold text-white text-2xl">C</div>
          <h3 class="mt-5 text-xl font-semibold text-[#263238]">Camelia</h3>
          <p class="text-sm text-[#52636b]">Support client</p>
        </article>
      </div>
      <p class="mt-8 text-center text-lg text-[#52636b]">
        Et nos partenaires : HBC, Microsoft, Bitdefender, OVHcloud.
      </p>
    </div>
  </section>

  <!-- Section 8 : Contact + Footer -->
  <section class="px-6 pt-20 sm:px-10 lg:px-16 lg:pt-24">
    <div class="mx-auto max-w-[112rem]">
      <div class="relative overflow-hidden rounded-3xl bg-[#00a7e1] px-8 py-16 text-center text-white sm:px-14 lg:py-24">
        <div class="absolute -right-20 -top-20 size-72 rounded-full border-[2rem] border-white/10"></div>
        <div class="absolute -bottom-28 -left-16 size-64 rounded-full border-[2rem] border-[#c8d600]/50"></div>
        <div class="relative mx-auto max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#dff8ff]">Contactez-nous</p>
          <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Parlons de votre projet.
          </h2>
          <p class="mt-4 text-lg text-white/80">
            33 Rue Grimaldi, Monaco — 06 78 56 54 30
          </p>
          <a href="/contact" class="mt-9 inline-flex h-15 items-center justify-center rounded-md bg-[#c8d600] px-8 text-lg font-semibold text-[#263238] shadow-lg transition hover:bg-[#d9e800]">
            Envoyer un message
            <i data-lucide="arrow-right" class="ml-3 size-5"></i>
          </a>
        </div>
      </div>
      <Footer />
    </div>
  </section>
</Layout>
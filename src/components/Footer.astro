    <div class="flex flex-wrap gap-x-7 gap-y-3 font-medium text-[#52636b]">
      <a href="/professionnel" class="hover:text-[#00a7e1]">Professionnel</a>
      <a href="/particulier" class="hover:text-[#00a7e1]">Particulier</a>
      <a href="/services" class="hover:text-[#00a7e1]">Services</a>

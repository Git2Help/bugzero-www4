---
// Header.astro
---

<header class="flex w-full items-center justify-between px-6 py-6 sm:px-10 lg:px-16">
  <a href="/" aria-label="BugZero" class="block">
    <img src="/bugzero-logo.png" alt="Logo BugZero" class="h-12 w-auto sm:h-14" />
  </a>
  <nav class="hidden items-center gap-9 text-base font-medium text-[#263238] lg:flex">
    <a href="/professionnel" class="transition hover:text-[#00a7e1]">Professionnel</a>
    <a href="/particulier" class="transition hover:text-[#00a7e1]">Particulier</a>
    <a href="/services" class="transition hover:text-[#00a7e1]">Services</a>
    <a href="#expertises" class="transition hover:text-[#00a7e1]">Expertises</a>
    <a href="#pourquoi" class="transition hover:text-[#00a7e1]">Pourquoi BugZero ?</a>
    <a href="#temoignages" class="transition hover:text-[#00a7e1]">Témoignages</a>
    <a href="/contact" class="rounded-md bg-[#00a7e1] px-6 py-3 text-white shadow-sm transition hover:bg-[#008fc7]">Demander un audit</a>
  </nav>
  <a href="/contact" class="rounded-md bg-[#00a7e1] px-4 py-3 text-sm font-medium text-white lg:hidden">
